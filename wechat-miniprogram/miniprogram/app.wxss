page {
  min-height: 100vh;
  background: #f7f3ea;
  color: #17211b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 6px;
  line-height: 1.2;
  font-size: 28rpx;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 48rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.title {
  display: block;
  color: #13231b;
  font-size: 48rpx;
  font-weight: 760;
  line-height: 1.15;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: #9b4b3f;
  font-size: 22rpx;
  font-weight: 700;
  text-transform: uppercase;
}

.muted {
  color: #68736d;
}

.primary-btn,
.quiet-btn,
.danger-btn {
  min-width: 112rpx;
  min-height: 64rpx;
  box-sizing: border-box;
  padding: 16rpx 22rpx;
  font-weight: 700;
}

.primary-btn {
  background: #126b5b;
  color: #fffaf0;
}

.quiet-btn {
  background: #ebe3d3;
  color: #21342b;
}

.danger-btn {
  background: #fde4de;
  color: #a33b2e;
}

.pill {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  min-height: 38rpx;
  box-sizing: border-box;
  padding: 8rpx 14rpx;
  border-radius: 6px;
  color: #1e332a;
  font-size: 22rpx;
  line-height: 1.2;
  background: #e7efe8;
}

.pill.source-hf {
  color: #5d3a00;
  background: #fff0c7;
}

.pill.source-arxiv {
  color: #113d63;
  background: #dff0fb;
}

.empty {
  margin-top: 64rpx;
  padding: 40rpx 28rpx;
  border: 1px solid #e0d7c8;
  border-radius: 8px;
  color: #68736d;
  text-align: center;
  background: #fffaf0;
}

.divider {
  height: 1px;
  margin: 28rpx 0;
  background: #e4dacb;
}

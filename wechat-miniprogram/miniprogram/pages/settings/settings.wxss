.header {
  margin-bottom: 28rpx;
}

.section {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1px solid #e0d7c8;
  border-radius: 8px;
  background: #fffaf0;
}

.field {
  min-height: 74rpx;
}

.label {
  display: block;
  color: #1b2d25;
  font-size: 28rpx;
  font-weight: 720;
}

.label.block {
  display: block;
  margin-bottom: 16rpx;
}

.value {
  color: #9b4b3f;
  font-size: 30rpx;
  font-weight: 760;
}

.hint {
  display: block;
  margin-top: 6rpx;
  color: #68736d;
  font-size: 22rpx;
  line-height: 1.35;
}

textarea {
  width: 100%;
  min-height: 148rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 1px solid #e4dacb;
  border-radius: 8px;
  color: #17211b;
  font-size: 27rpx;
  line-height: 1.45;
  background: #f9f3e8;
}

.text-input {
  width: 100%;
  min-height: 72rpx;
  box-sizing: border-box;
  margin-bottom: 14rpx;
  padding: 0 18rpx;
  border: 1px solid #e4dacb;
  border-radius: 8px;
  color: #17211b;
  font-size: 27rpx;
  background: #f9f3e8;
}

.section textarea + textarea,
.section .section-hint {
  margin-top: 14rpx;
}

.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.cloud-state {
  display: inline-flex;
  min-height: 48rpx;
  align-items: center;
  padding: 10rpx 14rpx;
  border-radius: 6px;
  color: #855245;
  font-size: 24rpx;
  background: #fde4de;
}

.cloud-state.ready {
  color: #1d5d50;
  background: #e7efe8;
}

.header {
  margin-bottom: 26rpx;
}

.header-actions {
  display: flex;
  gap: 14rpx;
}

.small {
  min-width: 96rpx;
  min-height: 58rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
}

.toolbar {
  margin-bottom: 18rpx;
}

.source-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.segmented {
  display: inline-flex;
  gap: 8rpx;
  padding: 6rpx;
  border: 1px solid #e0d7c8;
  border-radius: 8px;
  background: #fffaf0;
}

.seg {
  min-width: 96rpx;
  min-height: 56rpx;
  padding: 12rpx 18rpx;
  color: #51615a;
  font-weight: 700;
}

.seg.on {
  color: #fffaf0;
  background: #1b2d25;
}

.refresh {
  min-width: 108rpx;
  margin-left: 14rpx;
}

.search {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  margin-bottom: 18rpx;
  padding: 0 14rpx 0 22rpx;
  border: 1px solid #e0d7c8;
  border-radius: 8px;
  background: #fffaf0;
}

.search input {
  flex: 1;
  min-width: 0;
  color: #17211b;
  font-size: 28rpx;
}

.clear {
  min-width: 76rpx;
  min-height: 52rpx;
  color: #9b4b3f;
  font-size: 24rpx;
  font-weight: 700;
}

.status {
  margin: 8rpx 0 20rpx;
  font-size: 24rpx;
}

.notice {
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 8px;
  color: #8b3428;
  background: #fde4de;
}

.paper-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.paper-card {
  display: flex;
  gap: 18rpx;
  padding: 20rpx;
  border: 1px solid #e0d7c8;
  border-radius: 8px;
  background: #fffaf0;
}

.paper-card.read {
  opacity: 0.76;
}

.thumb {
  width: 156rpx;
  height: 156rpx;
  flex: 0 0 156rpx;
  border-radius: 6px;
  background: #e4dacb;
}

.paper-body {
  flex: 1;
  min-width: 0;
}

.paper-meta {
  margin-bottom: 12rpx;
}

.meta-left {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 10rpx;
}

.meta-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
}

.score {
  min-width: 72rpx;
  padding: 8rpx 10rpx;
  border-radius: 6px;
  color: #795b13;
  font-size: 21rpx;
  font-weight: 760;
  text-align: center;
  background: #fff1c9;
}

.date {
  color: #68736d;
  font-size: 22rpx;
}

.fav {
  min-width: 76rpx;
  min-height: 46rpx;
  padding: 10rpx 12rpx;
  color: #68736d;
  font-size: 22rpx;
  font-weight: 700;
  background: #f2eadc;
}

.fav.saved {
  color: #fffaf0;
  background: #c4563f;
}

.paper-title {
  display: block;
  color: #13231b;
  font-size: 31rpx;
  font-weight: 760;
  line-height: 1.32;
}

.summary {
  display: block;
  margin-top: 12rpx;
  color: #33433b;
  font-size: 26rpx;
  line-height: 1.48;
}

.authors {
  display: block;
  margin-top: 10rpx;
  color: #68736d;
  font-size: 23rpx;
  line-height: 1.35;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.tag {
  max-width: 260rpx;
  padding: 7rpx 10rpx;
  border-radius: 6px;
  color: #48574f;
  font-size: 21rpx;
  background: #eef4ec;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hits {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.hit {
  max-width: 280rpx;
  padding: 7rpx 10rpx;
  border-radius: 6px;
  color: #126b5b;
  font-size: 21rpx;
  background: #e2f3ed;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (max-width: 360px) {
  .paper-card {
    flex-direction: column;
  }

  .thumb {
    width: 100%;
    height: 260rpx;
  }
}

.header {
  margin-bottom: 24rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.stat {
  padding: 18rpx;
  border: 1px solid #e0d7c8;
  border-radius: 8px;
  background: #fffaf0;
}

.stat text {
  display: block;
  color: #68736d;
  font-size: 22rpx;
}

.stat strong {
  display: block;
  margin-top: 8rpx;
  color: #13231b;
  font-size: 38rpx;
}

.segmented {
  display: flex;
  gap: 8rpx;
  margin-bottom: 18rpx;
  padding: 6rpx;
  border: 1px solid #e0d7c8;
  border-radius: 8px;
  background: #fffaf0;
}

.seg {
  flex: 1;
  min-height: 58rpx;
  color: #51615a;
  font-weight: 700;
}

.seg.on {
  color: #fffaf0;
  background: #1b2d25;
}

.section {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1px solid #e0d7c8;
  border-radius: 8px;
  background: #fffaf0;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: #1b2d25;
  font-size: 30rpx;
  font-weight: 760;
}

.markdown {
  display: block;
  color: #25352e;
  font-size: 25rpx;
  line-height: 1.58;
  white-space: pre-wrap;
}

.desc {
  display: block;
  margin-bottom: 12rpx;
  color: #51615a;
  font-size: 25rpx;
  line-height: 1.45;
}

.branch {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1px solid #e4dacb;
}

.branch-title {
  display: block;
  margin-bottom: 12rpx;
  color: #126b5b;
  font-size: 28rpx;
  font-weight: 760;
}

.mini-paper,
.paper-row {
  display: grid;
  gap: 8rpx;
  padding: 14rpx 0;
  border-top: 1px solid #eee4d6;
}

.mini-paper:first-of-type,
.paper-row:first-of-type {
  border-top: 0;
}

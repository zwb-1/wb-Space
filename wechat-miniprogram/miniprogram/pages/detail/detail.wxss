.detail {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.top {
  padding-bottom: 8rpx;
}

.meta-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.date {
  color: #68736d;
  font-size: 24rpx;
}

.score {
  padding: 8rpx 10rpx;
  border-radius: 6px;
  color: #795b13;
  font-size: 22rpx;
  font-weight: 760;
  background: #fff1c9;
}

.detail-title {
  display: block;
  color: #13231b;
  font-size: 42rpx;
  font-weight: 780;
  line-height: 1.22;
}

.authors {
  display: block;
  margin-top: 16rpx;
  color: #58675f;
  font-size: 25rpx;
  line-height: 1.42;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.actions button {
  min-width: 108rpx;
}

.cover {
  width: 100%;
  height: 340rpx;
  border-radius: 8px;
  background: #e4dacb;
}

.section {
  padding: 24rpx;
  border: 1px solid #e0d7c8;
  border-radius: 8px;
  background: #fffaf0;
}

.section-head {
  margin-bottom: 16rpx;
  color: #1b2d25;
  font-size: 28rpx;
  font-weight: 760;
}

.mini {
  font-size: 22rpx;
  font-weight: 500;
}

.paragraph,
.analysis {
  display: block;
  color: #2d3c35;
  font-size: 28rpx;
  line-height: 1.62;
  white-space: pre-wrap;
}

.analysis {
  color: #18241e;
}

.analysis-empty {
  padding: 26rpx 20rpx;
  border-radius: 8px;
  color: #68736d;
  text-align: center;
  background: #f4edde;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  max-width: 300rpx;
  padding: 8rpx 12rpx;
  border-radius: 6px;
  color: #48574f;
  font-size: 22rpx;
  background: #eef4ec;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hit {
  max-width: 320rpx;
  padding: 8rpx 12rpx;
  border-radius: 6px;
  color: #126b5b;
  font-size: 22rpx;
  background: #e2f3ed;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

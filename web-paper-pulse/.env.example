# Optional. OpenAlex works without a key, but a mailto improves polite-pool behavior.
OPENALEX_MAILTO=your_email@example.com

# Optional paid/free personal keys. Leave empty if you do not use these sources.
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Optional local port.
PORT=8787

# Optional. Set a long random string in production so sync tokens/password hashes are isolated.
SYNC_SECRET=replace_with_a_long_random_secret

# Optional. If you have your own LibreTranslate service, it will be used before the built-in free fallback.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Optional. Copy your own logged-in EasyScholar cookie here to let the server enrich journal IF/partition.
# Keep this private and set it only in Render environment variables.
EASYSCHOLAR_COOKIE=
EASYSCHOLAR_MAX_LOOKUPS=20

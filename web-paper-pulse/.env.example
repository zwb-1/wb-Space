# Optional. OpenAlex works without a key, but a mailto improves polite-pool behavior.
OPENALEX_MAILTO=your_email@example.com

# Optional paid/free personal keys. Leave empty if you do not use these sources.
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Optional local port.
PORT=8787

# Optional. Set a long random string in production so sync tokens/password hashes are isolated.
SYNC_SECRET=replace_with_a_long_random_secret

# Optional. If you have your own LibreTranslate service, it will be used before the built-in free fallback.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Optional. Comma-separated Lingva mirrors used after Microsoft/Google if you maintain your own mirrors.
LINGVA_TRANSLATE_URLS=

# Optional. Prefer the official EasyScholar Open API SecretKey. Cookie is only a fallback.
# Keep these private and set them only in Render environment variables.
EASYSCHOLAR_SECRET_KEY=
# Optional fallback. If SecretKey is not set, the server can log in and request one.
EASYSCHOLAR_USERNAME=
EASYSCHOLAR_PASSWORD=
EASYSCHOLAR_COOKIE=
EASYSCHOLAR_MAX_LOOKUPS=20
